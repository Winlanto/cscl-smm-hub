generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum Platform {
  DISCORD
  TELEGRAM
  TWITTER
  FACEIT
  SITE
}

enum PostCategory {
  ANNOUNCEMENTS
  STANDINGS
  CS2_NEWS
  SPONSORED
}

enum PostStatus {
  DRAFT
  PUBLISHED
  PARTIAL
  FAILED
}

enum TargetStatus {
  PENDING
  PUBLISHED
  FAILED
}

model Post {
  id        String       @id @default(cuid())
  title     String?
  category  PostCategory @default(ANNOUNCEMENTS)
  content   String
  mediaUrls String[]
  status    PostStatus   @default(DRAFT)

  targets PostTarget[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model PostTarget {
  id     String @id @default(cuid())
  postId String
  post   Post   @relation(fields: [postId], references: [id], onDelete: Cascade)

  platform   Platform
  channelKey String   @default("default")
  customText String?

  status      TargetStatus @default(PENDING)
  externalId  String?
  apiResponse Json?

  publishedAt DateTime?
  updatedAt   DateTime  @updatedAt

  @@unique([postId, platform, channelKey])
  @@unique([platform, externalId])
}
