# Application Runtime
NODE_ENV="development"
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# PostgreSQL 17 Database
POSTGRES_USER="cscl_admin"
POSTGRES_PASSWORD="cscl_password"
POSTGRES_DB="cscl_smm_hub"
DATABASE_URL="postgresql://cscl_admin:cscl_password@localhost:5432/cscl_smm_hub?schema=public"

# Cloudflare R2 Storage
R2_ACCOUNT_ID="test_account_id"
R2_ACCESS_KEY_ID="test_access_key"
R2_SECRET_ACCESS_KEY="test_secret_key"
R2_BUCKET_NAME="cscl-smm-media"
R2_PUBLIC_URL="https://media.smm.cscl.gg"